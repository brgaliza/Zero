# O Zero cria .env.local exclusivamente ao iniciar o ambiente local.
# Nunca versione .env.local ou use estes valores como credenciais reais.
ZERO_POSTGRES_USER="zero"
ZERO_POSTGRES_PASSWORD="substitua-por-um-secret-local"
ZERO_POSTGRES_DATABASE="app"
ZERO_POSTGRES_PORT="5432"
PORT="3000"
DATABASE_URL="postgresql://zero:substitua-por-um-secret-local@127.0.0.1:5432/app?schema=public"
ZERO_REDIS_PORT="6379"
ZERO_REDIS_PASSWORD="substitua-por-um-secret-local"
REDIS_URL="redis://:substitua-por-um-secret-local@127.0.0.1:6379"
ZERO_MINIO_API_PORT="9000"
ZERO_MINIO_CONSOLE_PORT="9001"
ZERO_MINIO_ROOT_USER="zero"
ZERO_MINIO_ROOT_PASSWORD="substitua-por-um-secret-local"
ZERO_STORAGE_BUCKET="uploads"
STORAGE_ENDPOINT="http://127.0.0.1:9000"
ZERO_MAILPIT_SMTP_PORT="1025"
ZERO_MAILPIT_WEB_PORT="8025"
SMTP_URL="smtp://127.0.0.1:1025"
