{
  "name": "zero-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24 || ^26",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-cli.mjs",
    "generate:beta-guide": "node scripts/generate-beta-guide.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check package.json tsconfig.json eslint.config.mjs prettier.config.mjs packages scripts schemas",
    "test": "vitest run",
    "test:package": "npm run build && node scripts/verify-package.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:package"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
