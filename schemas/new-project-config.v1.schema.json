{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zero.local/schemas/new-project-config.v1.schema.json",
  "title": "Zero NewProjectConfig v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "profile", "initialization"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "slug", "directory"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 280 },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "directory": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "profile": { "const": "essential" },
    "initialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "git", "github"],
      "properties": {
        "start": { "const": false },
        "git": { "const": false },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": ["createPrivateRepository"],
          "properties": {
            "createPrivateRepository": { "const": false }
          }
        }
      }
    }
  }
}
